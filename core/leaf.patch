+#if defined(__linux__)
+/* Leaf: fill leafJar, leafJava and leafLibraryPath from the directory holding this core. */
+static void leaf_find_bundle(void)
+{
+	Dl_info self;
+	char coreDir[PATH_MAX_LENGTH];
+	char jreDir[PATH_MAX_LENGTH];
+	char *base;
+	const char *inherited = getenv("LD_LIBRARY_PATH");
+	int n;
+
+	leafJar[0] = '\0';
+	leafJava[0] = '\0';
+	leafLibraryPath[0] = '\0';
+
+	if (!dladdr((void *)&leaf_find_bundle, &self) || !self.dli_fname) { return; }
+	if (!realpath(self.dli_fname, coreDir)) { return; }
+	if (!(base = strrchr(coreDir, '/'))) { return; }
+	*base = '\0';
+
+	n = snprintf(jreDir, sizeof(jreDir), "%s/jre", coreDir);
+	if (n < 0 || (size_t)n >= sizeof(jreDir)) { return; }
+	n = snprintf(leafJar, sizeof(leafJar), "%s/%s", coreDir, freej2meapp);
+	if (n < 0 || (size_t)n >= sizeof(leafJar)) { leafJar[0] = '\0'; return; }
+	n = snprintf(leafJava, sizeof(leafJava), "%s/bin/java", jreDir);
+	if (n < 0 || (size_t)n >= sizeof(leafJava) || access(leafJar, R_OK) != 0 || access(leafJava, X_OK) != 0)
+	{
+		log_fn(RETRO_LOG_INFO, "No bundled jar and Java runtime in %s; using the system directory and PATH.\n", coreDir);
+		leafJar[0] = '\0';
+		leafJava[0] = '\0';
+		return;
+	}
+
+	/*
+	 * The JRE's own libraries first, then whatever the frontend was given.
+	 * lib/server leads: the java launcher re-executes itself to fix up a
+	 * LD_LIBRARY_PATH that names a libjvm directory without starting with
+	 * its own.
+	 */
+	if (inherited && *inherited)
+	{
+		n = snprintf(leafLibraryPath, sizeof(leafLibraryPath),
+			"LD_LIBRARY_PATH=%s/lib/server:%s/lib:%s", jreDir, jreDir, inherited);
+	}
+	else
+	{
+		n = snprintf(leafLibraryPath, sizeof(leafLibraryPath),
+			"LD_LIBRARY_PATH=%s/lib/server:%s/lib", jreDir, jreDir);
+	}
+	if (n < 0 || (size_t)n >= sizeof(leafLibraryPath))
+	{
+		n = snprintf(leafLibraryPath, sizeof(leafLibraryPath),
+			"LD_LIBRARY_PATH=%s/lib/server:%s/lib", jreDir, jreDir);
+	}
+
+	log_fn(RETRO_LOG_INFO, "Using the bundled Java runtime: %s\n", leafJava);
+}
+
+/* Leaf: the frontend's environment with LD_LIBRARY_PATH replaced. Built
+ * before fork() so the child only has to call execve(). */
+static char **leaf_child_environment(void)
+{
+	size_t count = 0, kept = 0, i;
+	char **env;
+
+	while (environ && environ[count]) { count++; }
+	if (!(env = malloc(sizeof(char *) * (count + 2)))) { return NULL; }
+	for (i = 0; i < count; i++)
+	{
+		if (strncmp(environ[i], "LD_LIBRARY_PATH=", 16) != 0) { env[kept++] = environ[i]; }
+	}
+	env[kept++] = leafLibraryPath;
+	env[kept] = NULL;
+	return env;
+}
